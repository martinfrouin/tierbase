{
  "name": "tierbase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:catalog": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/sync-catalog.ts",
    "sync:threads": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/sync-threads.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/seed-db.ts",
    "db:up": "docker compose up -d --wait",
    "stats": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/stats.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
